{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "IvySecretsManagerReadAccess",
            "Effect": "Allow",
            "Action": [
                "secretsmanager:GetSecretValue",
                "secretsmanager:DescribeSecret"
            ],
            "Resource": "arn:aws:secretsmanager:eu-west-1:*:secret:IVY_*"
        },
        {
            "Sid": "DenyNonIvySecrets",
            "Effect": "Deny",
            "Action": [
                "secretsmanager:GetSecretValue"
            ],
            "NotResource": "arn:aws:secretsmanager:eu-west-1:*:secret:IVY_*"
        }
    ]
}
